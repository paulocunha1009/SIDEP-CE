VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Compatibilidade com projetos antigos. Se usar a chave nova acima, nao precisa desta.
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Somente para teste LOCAL, sem Supabase configurado (login local do administrador
# master). Defina isso apenas no seu .env.local pessoal, NUNCA no Vercel/producao
# e NUNCA faca commit de um valor real aqui. Sem essa variavel, o login local do
# master fica desabilitado (nao ha senha padrao).
VITE_LOCAL_MASTER_PASSWORD=defina-uma-senha-so-para-seu-ambiente-local
